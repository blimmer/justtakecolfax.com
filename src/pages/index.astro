---
import Marquee from "../components/Marquee.astro";
import MotelSign from "../components/MotelSign.astro";
import NeonSign from "../components/NeonSign.astro";
import Ticker from "../components/Ticker.astro";
import BaseLayout from "../layouts/BaseLayout.astro";

const amenities = [
  "Color TV",
  "Hourly rates",
  "Ice machine (out of order)",
  "Cash only",
  "Locks on most doors",
  "Free sidewalk entertainment",
  "Front desk behind glass",
  "Free parking (parallel)",
];

const rates = [
  { value: "12/12", label: "Months under construction" },
  { value: "1", label: "Satisfied driver" },
  { value: "∞", label: "Stoplights", symbol: true },
  { value: "0", label: "Regrets" },
];
---

<BaseLayout>
  <section class="hero container">
    <div>
      <h1>
        <span class="kicker">The choice is clear ...</span>
        <span class="punch">just take Colfax!</span>
      </h1>
      <p class="lead">
        No matter where you're trying to go in Denver, it just makes sense to
        take Colfax. That's science and you can't argue with science.
      </p>
      <a href="/directions/" class="button">
        Let's Drive &raquo;
      </a>
    </div>
    <div class="motel-sign">
      <MotelSign />
    </div>
  </section>

  <Ticker label="Amenities" items={amenities} />

  <section class="windows container">
    <h2>Open all night, every night</h2>
    <div class="window-grid">
      <div class="window">
        <NeonSign tone="pink">No Excuses</NeonSign>
        <p>
          "6th Avenue is faster" is an excuse. "I-25 is right there" is an
          excuse. We don't take excuses. We take Colfax.
        </p>
      </div>
      <div class="window">
        <NeonSign tone="cyan" buzz>
          Open 24 Hrs
        </NeonSign>
        <p>
          Colfax never closes. Your GPS will keep suggesting a faster route.
          Ignore it. Your GPS has never loved anything.
        </p>
      </div>
      <div class="window">
        <NeonSign tone="amber">Vacancy</NeonSign>
        <p>
          There's always room on Colfax. Cruise from Golden to Aurora, past the
          Capitol, the Ogden, and the Bluebird. No turns required.
        </p>
      </div>
    </div>
  </section>

  <section class="marquee container">
    <Marquee
      heading="Tonight Only"
      quote="I usually take C-470 whenever I can, but when I'm downtown I always take Colfax"
      cite="Mike Chambliss, Driver"
    />
  </section>

  <section class="rates container" aria-label="Rates">
    <dl>
      {rates.map(({ value, label, symbol }) => (
        <div>
          <dt>{label}</dt>
          <dd class:list={{ symbol }}>{value}</dd>
        </div>
      ))}
    </dl>
  </section>
</BaseLayout>

<style>
  .hero {
    display: grid;
    grid-template-columns: 1.25fr 1fr;
    align-items: center;
    gap: 3rem;
    padding-block: 4.5rem 3.5rem;
  }

  h1 {
    margin: 0;
    font-weight: 400;
    line-height: 1;
  }

  .kicker {
    display: block;
    font-size: clamp(1.6rem, 3.5vw, 2.4rem);
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .punch {
    display: block;
    margin-top: 0.5rem;
    font-family: var(--font-script);
    font-size: clamp(4rem, 10vw, 7.25rem);
    line-height: 1.05;
    color: var(--color-pink-core);
    text-shadow: var(--glow-pink);
    transform: rotate(-4deg);
    transform-origin: left center;
  }

  .lead {
    max-width: 34rem;
    margin: 2rem 0 2.25rem;
    font-size: 1.45rem;
  }

  .windows {
    padding-block: 5rem 2rem;
  }

  h2 {
    margin: 0 0 2rem;
    text-align: center;
    font-family: var(--font-script);
    font-weight: 400;
    font-size: clamp(2.5rem, 6vw, 3.5rem);
    line-height: 1.1;
    color: var(--color-cyan-core);
    text-shadow: var(--glow-cyan);
    text-wrap: balance;
  }

  .window-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
  }

  .window {
    padding: 2rem 1.5rem 1.75rem;
    text-align: center;
    border: 1px solid var(--color-edge);
    border-radius: var(--radius);
    background:
      linear-gradient(rgb(255 255 255 / 0.03), rgb(255 255 255 / 0)),
      var(--color-night-2);
  }

  .window p {
    margin: 1.25rem 0 0;
    font-size: 1.2rem;
  }

  .marquee {
    padding-block: 4rem 2rem;
  }

  .rates {
    padding-block: 3rem 1rem;
  }

  dl {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    max-width: 54rem;
    margin: 0 auto;
    border: 1px solid var(--color-edge);
    border-radius: var(--radius);
    background: var(--color-night-2);
  }

  dl div {
    display: flex;
    flex-direction: column-reverse;
    justify-content: flex-end;
    padding: 1.25rem 1rem;
    text-align: center;
  }

  dl div + div {
    border-left: 1px dashed var(--color-edge-2);
  }

  dd {
    margin: 0;
    font-size: 2.2rem;
    font-weight: 700;
    line-height: 1.1;
    color: var(--color-cyan-core);
    text-shadow:
      0 0 6px var(--color-cyan),
      0 0 16px var(--color-cyan);
  }

  .symbol {
    font-family: sans-serif;
  }

  dt {
    font-size: 1rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-muted);
  }

  @media (max-width: 820px) {
    .hero {
      grid-template-columns: 1fr;
      gap: 2.5rem;
      padding-block: 2.5rem;
    }

    .motel-sign {
      order: -1;
    }

    .window-grid {
      grid-template-columns: 1fr;
    }

    dl {
      grid-template-columns: repeat(2, 1fr);
    }

    dl div:nth-child(3) {
      border-left: 0;
    }

    dl div:nth-child(n + 3) {
      border-top: 1px dashed var(--color-edge-2);
    }
  }

  @media (max-width: 480px) {
    .kicker {
      font-size: 1.45rem;
    }

    .punch {
      margin-top: 0.9rem;
      font-size: 3.5rem;
      transform: rotate(-3deg);
    }

    .lead {
      font-size: 1.3rem;
    }

    h2 {
      font-size: 2.3rem;
    }
  }
</style>
