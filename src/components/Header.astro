---
const links = [
  { href: "/", label: "Home" },
  { href: "/directions/", label: "Directions" },
];
---

<header>
  <nav class="container">
    <a class="brand" href="/">
      Just Take Colfax
    </a>
    <ul>
      {links.map(({ href, label }) => (
        <li>
          <a
            href={href}
            aria-current={Astro.url.pathname === href ? "page" : undefined}
          >
            {label}
          </a>
        </li>
      ))}
    </ul>
  </nav>
</header>

<style>
  header {
    position: sticky;
    top: 0;
    z-index: 10;
    background: rgb(12 10 16 / 0.85);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid rgb(255 46 136 / 0.25);
  }

  nav {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem 1.5rem;
    padding-block: 0.75rem;
  }

  .brand {
    font-family: var(--font-script);
    font-size: 1.9rem;
    line-height: 1;
    color: var(--color-pink-core);
    text-decoration: none;
    text-shadow: var(--glow-pink);
  }

  ul {
    display: flex;
    gap: 1.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: 1rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  ul a {
    color: var(--color-muted);
    text-decoration: none;
  }

  ul a:hover,
  ul a[aria-current="page"] {
    color: var(--color-cyan-core);
    text-shadow: var(--glow-cyan);
  }

  @media (max-width: 480px) {
    .brand {
      font-size: 1.6rem;
    }

    ul {
      gap: 1rem;
      font-size: 0.9rem;
    }
  }
</style>
