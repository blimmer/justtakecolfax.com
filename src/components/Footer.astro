---
const year = new Date().getFullYear();
---

<footer>
  <div class="container">
    <p>
      &copy; 2013&ndash;{year} <a href="https://benlimmer.com">Ben Limmer</a>
    </p>
    <p>Management not responsible for lost time or valuables.</p>
  </div>
</footer>

<style>
  footer {
    margin-top: 4rem;
    padding-block: 1.75rem 2.5rem;
    border-top: 1px solid var(--color-edge);
    font-size: 1rem;
    color: var(--color-muted);
  }

  .container {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem 2rem;
  }

  p {
    margin: 0;
  }

  a {
    color: var(--color-pink-core);
    text-decoration: none;
  }

  a:hover {
    text-shadow: var(--glow-pink);
  }
</style>
